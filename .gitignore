# Python Bytecode & Environment
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
venv/
env/
.venv/
python_runtime/

# Node & Frontend Build
node_modules/
frontend/node_modules/
.npm/
!frontend/dist/
!frontend/dist/**

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/

# Logs & Temporary Files
*.log
*.tmp
*.temp
debug-logs/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Server runtime uploads & generated reports (keep directories, ignore runtime outputs)
backend/static/uploads/*
backend/static/outputs/*
backend/static/outputs_m2/*
backend/static/outputs_m3/*
backend/static/outputs_m4/*
backend/static/reports/*
!backend/static/uploads/.gitkeep
!backend/static/outputs/.gitkeep
!backend/static/outputs_m2/.gitkeep
!backend/static/outputs_m3/.gitkeep
!backend/static/outputs_m4/.gitkeep
!backend/static/reports/.gitkeep
outputs/*
!outputs/.gitkeep
